{
  "version": "2.0.0",

  // URUCHAMIANIE:
  // Mac: Cmd + Shift + B
  // Windows/Linux: Ctrl + Shift + B
  // Menu: Terminal → Run Build Task
  //
  // STRONA: http://localhost:3000
  // ZATRZYMANIE: Terminal → Terminate Task

  "tasks": [
    {
      "label": "Uruchom stronę z odświeżaniem",
      "detail": "Uruchamia serwer PHP oraz automatyczne odświeżanie przeglądarki.",
      "dependsOn": [
        "Serwer PHP",
        "Automatyczne odświeżanie"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Serwer PHP",
      "detail": "Serwer strony działający pod adresem http://127.0.0.1:8000",
      "type": "process",
      "command": "php",
      "args": [
        "-S",
        "127.0.0.1:8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "serwer"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Automatyczne odświeżanie",
      "detail": "Obserwuje pliki PHP, HTML, CSS i JS. Strona: http://localhost:3000",
      "type": "process",
      "command": "npx",
      "args": [
        "--yes",
        "browser-sync",
        "start",
        "--proxy",
        "http://127.0.0.1:8000",
        "--port",
        "3000",
        "--files",
        "**/*.{php,html,css,js}",
        "--ignore",
        "node_modules/**",
        "--no-inject-changes",
        "--no-notify"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "serwer"
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}